{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Cascade 4.1 Design Tokens",
  "version": "1.0.0",
  "source": "frontend/src/design/tokens.css",
  "colors": {
    "light": {
      "canvas": "#f5f7f4",
      "surface": "#ffffff",
      "recessed": "#e9eee8",
      "text": "#17231d",
      "muted": "#53635a",
      "divider": "#d4ddd5",
      "controlBorder": "#748278",
      "action": "#f2b35c",
      "actionHover": "#e9a74a",
      "actionActive": "#e4a044",
      "actionInk": "#17231d",
      "actionBorder": "#8a5a18",
      "attention": "#6b420b",
      "attentionSurface": "#fbe9cc",
      "allowed": "#22643c",
      "allowedSurface": "#e1f0e6",
      "blocked": "#9b302e",
      "blockedSurface": "#f9e9e7",
      "focus": "#8a5a18",
      "selection": "#fbe9cc",
      "selectionInk": "#17231d"
    },
    "dark": {
      "canvas": "#111b18",
      "surface": "#1b2723",
      "recessed": "#24332b",
      "text": "#f5f7f4",
      "muted": "#b2beb6",
      "divider": "#394a40",
      "controlBorder": "#81988b",
      "action": "#f2b35c",
      "actionHover": "#fac479",
      "actionActive": "#e9a74a",
      "actionInk": "#17231d",
      "actionBorder": "#f2b35c",
      "attention": "#f2b35c",
      "attentionSurface": "#3b2f1c",
      "allowed": "#a6dfba",
      "allowedSurface": "#153d29",
      "blocked": "#ffc1bd",
      "blockedSurface": "#4a2423",
      "focus": "#f2b35c",
      "selection": "#f2b35c",
      "selectionInk": "#17231d"
    },
    "artwork": {
      "lockMetalTop": "#67736b",
      "lockMetalMid": "#344039",
      "lockMetalBottom": "#1c2721",
      "lockMetalEdge": "#121d17",
      "lockMetalHighlight": "#8a958c",
      "lockSteelLight": "#e0e5df",
      "lockSteelMid": "#8a968d",
      "lockSteelDark": "#46524a",
      "lockBrassLight": "#f6ce8c",
      "lockBrassDark": "#a67232",
      "lockBrassEdge": "#755226",
      "lockKeyhole": "#101a14",
      "lockShadow": "#142119",
      "lockShadowOpacityLight": 0.13,
      "lockShadowOpacityDark": 0.3,
      "lockDetailOpacity": 0.4,
      "dialogBackdrop": "rgb(0 0 0 / 0.45)"
    },
    "untokenizedHardcodedInCSS": {
      "success": "#16a34a",
      "danger": "#dc2626",
      "attentionFallback": "#ca8a04",
      "mutedFallback": "#6b7280"
    }
  },
  "typeScale": {
    "fontFamilies": {
      "display": "'Space Grotesk', 'Segoe UI', sans-serif",
      "body": "'Source Sans 3', 'Segoe UI', sans-serif",
      "technical": "'IBM Plex Mono', Consolas, monospace"
    },
    "fontWeights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "sizes": {
      "sm": "1rem",
      "body": "1.125rem",
      "lead": "1.25rem",
      "title": "1.5rem",
      "heading": "clamp(1.75rem, 3vw, 2.25rem)",
      "display": "clamp(2.75rem, 5.7vw, 4.75rem)",
      "specimen": "clamp(3rem, 7vw, 6rem)"
    },
    "lineHeights": {
      "body": 1.5,
      "heading": 1.15,
      "display": 1.05
    },
    "letterSpacing": {
      "heading": "-0.035em",
      "display": "-0.055em"
    }
  },
  "spacing": {
    "space1": "0.25rem",
    "space2": "0.5rem",
    "space3": "0.75rem",
    "space4": "1rem",
    "space5": "1.5rem",
    "space6": "2rem",
    "space7": "3rem",
    "space8": "4rem",
    "space9": "6rem",
    "pageGutter": "clamp(1.25rem, 4vw, 4rem)",
    "contentMax": "80rem",
    "measure": "70ch",
    "measureShort": "42ch",
    "heroMeasure": "13ch"
  },
  "radii": {
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem"
  },
  "shadows": {
    "light": {
      "control": "0 2px 0 #6b420b",
      "float": "0 12px 32px rgb(23 35 29 / 0.12)"
    },
    "dark": {
      "control": "0 2px 0 #a67232",
      "float": "0 12px 32px rgb(0 0 0 / 0.2)"
    }
  },
  "borders": {
    "borderWidth": "1px",
    "focusWidth": "3px",
    "focusOffset": "4px",
    "fieldBorderWidth": "1px",
    "lineDecoration": "2px"
  },
  "breakpoints": {
    "compact": "44rem",
    "wide": "68rem"
  },
  "zIndex": {
    "skip": 10,
    "rail": 3,
    "tabs": 4
  },
  "motion": {
    "durations": {
      "quick": "0.12s",
      "enter": "0.24s",
      "explain": "0.6s",
      "reduced": "0s"
    },
    "easings": {
      "default": "cubic-bezier(0.2, 0, 0, 1)",
      "points": [0.2, 0, 0, 1]
    },
    "pressY": {
      "normal": "1px",
      "reduced": "0px"
    }
  },
  "layoutDimensions": {
    "controlHeight": "3rem",
    "touchTarget": "2.75rem",
    "iconSize": "1.25rem",
    "brandSize": "2rem",
    "cardMinHeight": "10.5rem",
    "railWidth": "4rem",
    "railExpanded": "12rem",
    "tabsHeight": "4rem",
    "bottomRailHeight": "5rem",
    "tabLabelMax": "12rem",
    "dialogMax": "30rem",
    "drawerMax": "36rem",
    "executionLockWidth": "12rem",
    "lockWidth": "23rem",
    "lockRatio": "360 / 390",
    "lockFallbackSize": "5rem",
    "lockRestY": -40,
    "lockEngagedY": 0,
    "swatchHeight": "5rem",
    "swatchMarkerSize": "1.5rem",
    "radioDotSize": "0.5rem",
    "checkWidth": "0.375rem",
    "checkHeight": "0.75rem",
    "checkStroke": "2px"
  }
}