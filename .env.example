RPC_URL=http://127.0.0.1:8545
DATABASE_PATH=data/dao_accountability.db

# LLM Configuration (Local Ollama 2B)
LLM_MODE=local
LLM_ONLINE_PROVIDER=ollama
LLM_LOCAL_MODEL=gemma2:2b
LLM_LOCAL_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
LLM_TIMEOUT_S=60
LLM_CACHE=on

# Alternative: Online Provider (OpenAI / Gemini)
# LLM_MODE=online
# LLM_ONLINE_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your_key_here
# LLM_API_ENDPOINT=https://api.openai.com/v1/chat/completions
